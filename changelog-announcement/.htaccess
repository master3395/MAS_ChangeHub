# Deny ALL HTTP access to this tool. It is a CLI utility and must never be
# served over the web. Even if a vhost accidentally maps this directory,
# every request returns 403.

Options -Indexes -ExecCGI

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

<FilesMatch "^(config\.php|\.env|.*\.jsonl|.*\.log|.*\.sqlite|.*\.bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
