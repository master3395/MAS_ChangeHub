<?php
/**
 * Changelog Announcement: configuration + channel registry.
 *
 * Secrets live ONLY in this file (and the per-project config.php files this
 * adapter can read). Never commit real webhook URLs or database passwords.
 * File mode should be 600 and HTTP access is denied via .htaccess.
 *
 * Channels: each entry binds a logical name (e.g. "webhook-proxy") to one
 * source adapter (where the changelog rows live) and one Discord webhook
 * (where announcements get posted). Add new channels by appending to the
 * 'channels' array; nothing else needs editing.
 */

declare(strict_types=1);

if (!defined('CHANGELOG_ANNOUNCEMENT_APP_INIT')) {
    http_response_code(404);
    header('Content-Type: text/plain; charset=utf-8');
    header('X-Robots-Tag: noindex, nofollow');
    echo "Not found.\n";
    exit;
}

/**
 * Read an env var, fall back to a default. Trimmed.
 *
 * @template T
 * @param string $name
 * @param T      $default
 * @return T|string
 */
function changelog_announcement_env(string $name, $default = '')
{
    $value = getenv($name);
    if ($value === false || $value === null) {
        return $default;
    }
    $trimmed = trim((string) $value);
    return $trimmed === '' ? $default : $trimmed;
}

/**
 * Return the project root for this tool (one directory above config.php).
 */
function changelog_announcement_project_root(): string
{
    return __DIR__;
}

/**
 * Read a single getter from a remote project's config.php.
 *
 * Each newstargeted project has its own config.php that defines a function
 * like getWebhookConfig() or returns an array. We isolate the include into a
 * subprocess so we do not pollute this process with its constants.
 *
 * @return string Trimmed value, or '' on any failure.
 */
function changelog_announcement_read_project_value(string $configPhpPath, string $getterCall): string
{
    if ($configPhpPath === '' || !is_readable($configPhpPath)) {
        return '';
    }
    $php = 'require ' . var_export($configPhpPath, true) . '; echo (string) ' . $getterCall . ';';
    $cmd = '/usr/bin/php -r ' . escapeshellarg($php) . ' 2>/dev/null';
    $out = @shell_exec($cmd);
    if (!is_string($out)) {
        return '';
    }
    return trim($out);
}

/**
 * Helper: read a comma-separated env var into an array (trimmed, no empties).
 * @return array<int,string>
 */
function changelog_announcement_env_list(string $name): array
{
    $raw = changelog_announcement_env($name, '');
    if ($raw === '') return [];
    $out = [];
    foreach (preg_split('/\s*,\s*/', (string) $raw) as $part) {
        $part = trim((string) $part);
        if ($part !== '') $out[] = $part;
    }
    return $out;
}

